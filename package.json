{
  "name": "sasse-stocai",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prisma:generate": "pnpm dlx prisma@7 generate",
    "prisma:migrate": "pnpm dlx prisma@7 migrate dev --name",
    "prisma:reset": "pnpm dlx prisma@7 migrate reset",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "17.4.2",
    "nestjs-zod": "5.5.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/mau": "0.2.6",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "typescript": "6.0.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  },
  "imports": {
    "#shared-modules/*": {
      "types": "./src/modules/shared/modules/*.ts",
      "default": "./dist/modules/shared/modules/*.js"
    },
    "#shared-utils/*": {
      "types": "./src/modules/shared/utils/*.ts",
      "default": "./dist/modules/shared/utils/*.js"
    },
    "#modules/*": {
      "types": "./src/modules/*.ts",
      "default": "./dist/modules/*.js"
    }
  }
}
